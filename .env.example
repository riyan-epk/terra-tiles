# Copy this file to `.env` and fill in your values.

# Postgres connection string. When set, the app uses the real database;
# when unset, it falls back to the in-memory demo data.
# Get a free one from Neon (https://neon.tech) or Vercel Postgres.
# For a Neon POOLED url (host contains "-pooler"), append &pgbouncer=true so
# Prisma works reliably with the connection pooler.
# Example: postgresql://user:password@host-pooler.../dbname?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL=

# Shared admin passcode for the demo gate (defaults to demo1234 if unset).
ADMIN_PASSCODE=demo1234

# Your platform's root domain in production, for subdomain tenant routing.
# e.g. terravisualizer.com  (leave as localhost for local dev)
NEXT_PUBLIC_ROOT_DOMAIN=localhost
